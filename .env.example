# Gumroad checkout URLs for the three pack tiers.
# Static export bakes NEXT_PUBLIC_* values in at `npm run build`.
#
# Set them in:
#   - .env.local (local)
#   - Vercel → Project → Settings → Environment Variables
#   - GitHub → Settings → Secrets and variables → Actions → Variables
# Or paste URLs into src/lib/checkout.ts (HARD_SET_* strings) and leave these empty.
#
# Example:
# NEXT_PUBLIC_GUMROAD_STARTER=https://yourname.gumroad.com/l/client-close-starter
# NEXT_PUBLIC_GUMROAD_PRO=https://yourname.gumroad.com/l/client-close-pro
# NEXT_PUBLIC_GUMROAD_FULL=https://yourname.gumroad.com/l/client-close-full

NEXT_PUBLIC_GUMROAD_STARTER=
NEXT_PUBLIC_GUMROAD_PRO=
NEXT_PUBLIC_GUMROAD_FULL=

# Optional. Shown in the FAQ refund answer and footer.
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# Optional. Used in metadata / Open Graph.
# GitHub Pages default: https://rccoleman19.github.io/web-designer-client-pack
# NEXT_PUBLIC_SITE_URL=https://rccoleman19.github.io/web-designer-client-pack

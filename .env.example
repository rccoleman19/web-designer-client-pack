# Gumroad checkout URLs for the three pack tiers.
# Set these in Vercel → Project → Settings → Environment Variables
# (Production, Preview, and Development). Rebuild after changing them.
#
# Example:
# NEXT_PUBLIC_GUMROAD_STARTER=https://yourname.gumroad.com/l/client-close-starter
# NEXT_PUBLIC_GUMROAD_PRO=https://yourname.gumroad.com/l/client-close-pro
# NEXT_PUBLIC_GUMROAD_FULL=https://yourname.gumroad.com/l/client-close-full

NEXT_PUBLIC_GUMROAD_STARTER=
NEXT_PUBLIC_GUMROAD_PRO=
NEXT_PUBLIC_GUMROAD_FULL=

# Optional. Shown in the FAQ refund answer and footer.
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# Optional. Used in metadata / Open Graph if you set a custom domain later.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
